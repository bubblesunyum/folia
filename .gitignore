
# The live dashboard port, rewritten on every bind — machine-local.
.claude/launch.json

# The dashboard snapshot, rewritten on every poll — machine-local.
dashboard/state.json

# Per-role models, naming what this machine happens to have — machine-local.
harness/models.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# The app's build output and tooling caches.
node_modules/
dist/
build/
.react-router/
.vercel/
test-results/
playwright-report/
*.log
.env*.local
.DS_Store

# Blender's autosave backups beside the .blend sources.
*.blend1
.cache/
__pycache__/

# Agent scratch — created here, removed when done, never committed.
.tmp/
.vercel
.env*
